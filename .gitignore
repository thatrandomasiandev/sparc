*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Editors / OS
.idea/
.vscode/
*.swp
*.swo
