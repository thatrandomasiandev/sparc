Thumbs.db

# Secrets / local env
.env
.env.*
!.env.example
*.pem
credentials.json
secrets/

# Experiment artifacts: track runs so lab machines can pull results (I8).
# Still ignore bulky regenerable caches under artifacts/.
experiments/artifacts/**
!experiments/artifacts/.gitkeep
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/external/**
!data/external/.gitkeep

# Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# LaTeX build
# paper/build/  # tracked for lab sync
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.fdb_latexmk
paper/**/*.fls
paper/**/*.log
paper/**/*.out
paper/**/*.synctex.gz
paper/**/*.toc
paper/**/*.lof
paper/**/*.lot
paper/**/*.nav
paper/**/*.snm
paper/**/*.vrb
paper/**/*.bcf
paper/**/*.run.xml
