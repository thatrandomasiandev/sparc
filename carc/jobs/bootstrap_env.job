#!/bin/bash
# One-shot conda + editable install on a debug GPU node.
# Submit: ./carc/scripts/submit.sh carc/jobs/bootstrap_env.job

#SBATCH --job-name=research_bootstrap
#SBATCH --account=biyik_1165
#SBATCH --partition=debug
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus-per-task=p100:1
#SBATCH --mem=16G
#SBATCH --time=1:00:00
#SBATCH --output=/project2/biyik_1165/jjt_373/research/carc/logs/bootstrap-%j.out
#SBATCH --error=/project2/biyik_1165/jjt_373/research/carc/logs/bootstrap-%j.err

set -euo pipefail

if [[ -f /etc/profile.d/modules.sh ]]; then
  # shellcheck source=/dev/null
  source /etc/profile.d/modules.sh
fi

ROOT="/project2/biyik_1165/jjt_373/research"
mkdir -p "${ROOT}/carc/logs"
cd "${ROOT}"
export CARC_NETID="${USER}"
bash carc/scripts/bootstrap_env.sh
